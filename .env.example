# Used when OPENROUTER_API_KEY is empty. OpenAI-compatible Gemini endpoint.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-argon
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
INDUCTION_MODEL=openai/gpt-oss-120b
# Empty EVAL_MODEL inherits INDUCTION_MODEL.
EVAL_MODEL=
# Set to 1 to disable live model calls (valid cached responses can still be read).
SOLUTION_DISABLE_LLM=0
# Parallel model requests (default 4). Lower it if the provider returns HTTP 429.
LLM_WORKERS=4
# Default retains the template library; from_scratch starts with no rules.
ADAPT_MODE=hybrid
# Total adapt HTTP attempts, including template/induced verification and retries.
INDUCTION_MAX_CALLS=400
# Hard ceiling is six rounds. Pair limit is per round, balanced across topics.
INDUCTION_MAX_ROUNDS=6
INDUCTION_PAIRS_PER_ROUND=8
# Optional completion/reasoning cap; unset preserves the provider default.
# LLM_MAX_TOKENS=4096
