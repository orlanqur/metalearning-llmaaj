# Used when OPENROUTER_API_KEY is empty. OpenAI-compatible Gemini endpoint.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-argon
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
INDUCTION_MODEL=openai/gpt-oss-120b
# Empty EVAL_MODEL inherits INDUCTION_MODEL.
EVAL_MODEL=
# Set to 1 to disable live model calls (valid cached responses can still be read).
SOLUTION_DISABLE_LLM=0
